# Model provider: openai / ollama
MODEL_PROVIDER=openai

# Docker service ports
WEBUI_PORT=8000
OLLAMA_DOCKER_NETWORK=open-webui_default

# OpenAI-compatible API
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local Ollama
# - 本机直跑 uvicorn: http://127.0.0.1:11434/v1
# - Docker Compose: 由 docker-compose.yml 覆盖为 http://ollama:11434/v1，此处可保持默认
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Feishu Webhook
FEISHU_WEBHOOK=

# File paths (defaults are relative to project root)
RESUME_PATH=data/resume.json
BOSS_STATE_PATH=data/boss_state.json
KNOWLEDGE_DIR=data/knowledge
RESUME_VERSIONS_DIR=data/resume_versions
DB_PATH=data/jobmatch.db
CHROMA_DIR=storage/vector_store

# RAG
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5

# Matching
MATCH_THRESHOLD=75

# Boss login UX. When true and DISPLAY is available, /search opens a visible
# Chromium window for Boss login instead of only showing screenshots in WebUI.
BOSS_AUTO_OPEN_BROWSER=true
BOSS_VISIBLE_BROWSER_IN_DOCKER=true

# Web console security (set when exposing 0.0.0.0 or behind public reverse proxy)
WEBUI_API_TOKEN=

# Ops
LOG_LEVEL=INFO
SENTRY_DSN=
SCRAPE_COOLDOWN_HOURS=24
